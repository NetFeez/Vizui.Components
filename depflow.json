{
  "$schema": ".depflow/schema.json",
  "flowFolder": ".depflow",
  "outDir": "dist",
  "tsconfig": "tsconfig.json",
  "resolver": {},
  "actions": {},
  "dependencies": [
    {
      "name": "NetFeez/vizui",
      "repo": "https://github.com/NetFeez/vizui.git",
      "tag": "dev",
      "builder": [
        {
          "run": [
            "npm install",
            "npm run build"
          ]
        },
        {
          "extract": {
            "dist/**/*.d.ts": {
              "to": "lib/vizui",
              "map": "^dist"
            }
          }
        }
      ],
      "resolver": {
        "vizui": "lib/vizui/index.d.ts",
        "vizui/*": "lib/vizui/*"
      }
    },
    {
      "name": "NetFeez/qrcode",
      "repo": "https://github.com/NetFeez/qrcode.git",
      "tag": "main",
      "builder": [
        {
          "run": [
            "npm install",
            "npm run build"
          ]
        },
        {
          "extract": {
            "build/**/*.d.ts": {
              "to": "lib/qrcode",
              "map": "^build"
            }
          }
        }
      ],
      "resolver": {
        "qrcode": "lib/qrcode/QR.d.ts",
        "qrcode/*": "lib/qrcode/*"
      }
    }
  ],
  "npmDependencies": []
}