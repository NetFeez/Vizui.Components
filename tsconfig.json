{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist",
        "rootDir": "components",
        "declaration": true,
        "sourceMap": true,
        "strict": true,
        "types": [],
        "paths": {
            "vizui": [
                "./lib/vizui/index.d.ts"
            ],
            "vizui/*": [
                "./lib/vizui/*"
            ],
            "qrcode": [
                "./lib/qrcode/QR.d.ts"
            ],
            "qrcode/*": [
                "./lib/qrcode/*"
            ]
        }
    },
    "include": [
        "./components/**/*.ts"
    ]
}